{
  "name": "lifeos",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace @lifeos/web run dev",
    "build:web": "npm --workspace @lifeos/web run build",
    "typecheck:web": "npm --workspace @lifeos/web run typecheck",
    "infra:up": "podman compose up --build",
    "infra:down": "podman compose down"
  }
}
