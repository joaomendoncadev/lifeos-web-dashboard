# Copie este arquivo para `.env` e ajuste as portas caso já estejam em uso
# por outro projeto na sua máquina (erro comum: "port is already allocated").

POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos

# Portas expostas no host. Todas podem ser trocadas livremente sem afetar
# a comunicação interna entre os containers (que usa as portas padrão
# 5432/8080/3000 dentro da rede do compose).
POSTGRES_PORT=5432
API_PORT=8081
WEB_PORT=3000
