# Copie este arquivo para `.env` e ajuste as portas caso já estejam em uso
# por outro projeto na sua máquina (erro comum: "port is already allocated").

POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos

# Portas expostas no host. Todas podem ser trocadas livremente sem afetar
# a comunicação interna entre os containers (que usa as portas padrão
# 5432/8080/3000 dentro da rede do compose).
POSTGRES_PORT=5432
API_PORT=8081
WEB_PORT=3000

# Fuso horário do backend (usado para "hoje", vencimentos, streaks de hábitos etc.).
# Sem isso o container roda em UTC por padrão, o que desalinha "hoje" do seu dia real.
APP_TIMEZONE=America/Sao_Paulo

# Origem(ns) permitidas pelo backend para requisições da web (CORS).
# O padrão "*" libera qualquer origem — ok para uso pessoal em rede privada
# (ex.: Tailscale) sem autenticação. Troque por uma origem específica
# (ex.: http://localhost:3000) se quiser restringir.
CORS_ALLOWED_ORIGIN=*
