FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json ./

# Torna a instalação resiliente a oscilações temporárias de rede do registry npm.
# O loop repete a instalação até 5 vezes antes de encerrar o build.
RUN npm config set registry https://registry.npmjs.org/ \
    && npm config set fetch-retries 5 \
    && npm config set fetch-retry-factor 2 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm config set fetch-timeout 300000 \
    && for attempt in 1 2 3 4 5; do \
         echo "Tentativa ${attempt}/5 de instalar dependências npm"; \
         npm install --no-audit --no-fund --prefer-offline && break; \
         if [ "$attempt" = "5" ]; then \
           echo "Falha ao instalar dependências após 5 tentativas" >&2; \
           exit 1; \
         fi; \
         sleep $((attempt * 10)); \
       done

FROM node:22-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run typecheck && npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
